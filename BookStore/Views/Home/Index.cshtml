@model IEnumerable<BookStore.Data.Models.Product>

@{
    ViewData["Title"] = "Home Page";
}


<div class="row pb-3 backgroundWhite">
    @foreach (var product in Model)
    {
        var photoPath = $"/images/product/" + (product.ImageUrl);
        <div class="col-lg-3 col-md-6">
            <div class="row p-2">
                <div class="col-12 p-1" style="border:1px solid #008cba; border-radius: 5px;">
                    <div class="card" style="border:0px;">
                        <img src="@photoPath" class="card-img-top rounded" asp-append-version="true" />
                        <div class="ps-1 pt-1">
                            <p class="card-title h5"><b style="color: #E5E7E9">@product.Title</b></p>
                            <p class="card-title text-primary">by <b>@product.Author</b></p>
                        </div>
                        <div style="padding-left:5px;">
                            <p>List Price: <strike><b class="">@product.ListPrice.ToString("0,00")</b></strike></p>
                        </div>
                        <div style="padding-left:5px;">
                            <p style="color:maroon">As low as: <b class="">@product.price100.ToString("0,00")</b></p>
                        </div>
                    </div>
                    <div>
                        <a class="btn btn-outline-primary mt-1 form-control" asp-action="Details" asp-route-id="@product.Id">Details</a>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>

