@model BookStore.Data.ViewModels.ShoppingCartViewModel


<form method="post">
    <br />
    <div class="backgroundWhiteBorder">
        <div class="container">
            <div class="card">
                <div class="card-header bg-dark text-light ms-0 row container">
                    <div class="col-6">
                        Shopping Cart
                    </div>
                    <div class="col-6 text-end">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-info btn-sm">Continue Shopping</a>
                    </div>
                </div>
                <div class="card-body p-5 bg-dark bg-opacity-50">
                    <div class="row ">
                        @foreach (var cart in Model.CartsList)
                        {
                            var photoPath = $"/images/product/" + (cart.Product.ImageUrl);
                            <div class="d-none d-lg-block col-lg-1 mb-2  img-fluid">
                                <img src="@photoPath" class="rounded img-thumbnail img-fluid" width="100%" />
                            </div>
                            <div class="col-12 text-sm-center col-lg-6 text-lg-start">
                                <h5><strong>@cart.Product.Title</strong></h5>
                                <p><small>@cart.Product.Description</small></p>
                            </div>
                            <div class="col-12 text-sm-center col-lg-5 text-lg-right row">
                                <div class="col-4 text-md-end" style="padding-top:5px;">
                                    <h6><strong>@cart.Price<span class="text-muted">x</span>@cart.Count</strong></h6>
                                </div>
                                <div class="col-6 col-sm-4 col-lg-6">
                                    <div class="float-end mx-1">
                                        <button type="submit" asp-action="Plus" asp-route-cartId="@cart.Id" class="btn btn-primary">
                                            +
                                        </button>
                                    </div>
                                    <div class="float-end mx-1">
                                        <button type="submit" asp-action="Minus" asp-route-cartId="@cart.Id" class="btn btn-danger">
                                            -
                                        </button>
                                    </div>
                                </div>
                                <div class="col-2 col-sm-4 col-lg-2 text-right">
                                    <button type="submit" asp-action="Remove" asp-route-cartId="@cart.Id" class="btn btn-danger">
                                        Remove
                                    </button>
                                </div>
                            </div>
                            <hr />

                        }
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6 offset-md-6 col-lg-4 offset-lg-8 pr-4">
                            <ul class="list-group">
                                <li class="list-group-item d-flex justify-content-between bg-dark">
                                    <span class="text-info"> Total (USD)</span>
                                    <strong class="text-info">$ <span id="txtOrderTotal">@Model.OrderHeader.OrderTotal</span></strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="card-footer row">

                        <div class="col-sm-12 col-lg-4 col-md-6 offset-lg-8 offset-md-6 ">

                            <a class="btn btn-success form-control">Summary</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
