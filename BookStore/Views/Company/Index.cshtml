@{
    ViewData["Title"] = "Index";
}

<br />
<div class="row">
    <div class="col-6">
        <h2 class="text-primary">Company List </h2>
    </div>
    <div class="col-6 text-end">
        <a asp-action="Upsert" class="btn btn-primary">Create New Company</a>
    </div>
</div>

<br />
<div class="p-4 border rounded">
    <table id="tblData" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr class="table-dark">
                <th>Name</th>
                <th>Address</th>
                <th>City</th>
                <th>PhoneNumber</th>
                <th>IsAuthorizedCompany</th>
                <th></th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts{
    <script src="~/js/company.js"></script>
}
